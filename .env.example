# Copy this file to .env and fill in the values you need. No spaces, no quotes.
# .env is gitignored and must never be committed. orchestrate.py loads .env on start;
# runner/ scripts read only the process environment (e.g. CI secrets/variables).

# --- Engine (orchestrate.py) -------------------------------------------------
# fal.ai API key: all image, video and hosted ElevenLabs audio generation (required for paid runs).
FAL_KEY=
# ElevenLabs API key: music via the direct API (paid plan only; otherwise the engine falls back to fal).
ELEVENLABS_API_KEY=

# --- Brief writer (runner/brief_to_config.py) --------------------------------
# Anthropic API key: lets Claude write the config from the brief; without it a deterministic template is used.
ANTHROPIC_API_KEY=
# Optional override of the Anthropic API base URL (default https://api.anthropic.com; tests point it at a mock).
ANTHROPIC_API_URL=

# --- Production runner (runner/produce.py) -----------------------------------
# Base URL of the order API the runner claims work from; empty = nothing to do.
FILMBAM_API_URL=
# Shared secret sent as X-Worker-Secret to the order API.
FILMBAM_WORKER_SECRET=
# Maximum orders processed per run (default 2).
MAX_ORDERS=
# 1 = no paid calls: dry-run only, production replaced by a synthetic file (default 0).
DRY_RUN=
# Repository root holding orchestrate.py and projects/ (default: the repo containing runner/).
FILMBAM_REPO_ROOT=
# Prefix for per-order project folders under projects/ (default fb_).
FILMBAM_PROJECT_PREFIX=
# Per-order budget cap in US$ for films (default 30).
CAP_FILM_USD=
# Per-order budget cap in US$ for storyboards (default 5).
CAP_STORY_USD=
# Monthly cap in US$, used when the claim reply has monthly_spent but no monthly_cap (default 60).
CAP_MONTH_USD=
# Time limit in seconds for one --auto engine attempt (default 2400).
AUTO_TIMEOUT=
# Time limit in seconds from claim to done/failed for one order (default 6600).
ORDER_BUDGET_S=
# Time limit in seconds for the whole run; 0 = unlimited (default 0).
RUN_BUDGET_S=
# Hours after which the API re-queues an order stuck in 'producing' (default 2; must match the API).
API_ORPHAN_HOURS=
# Identifier the runner reports when claiming orders (default derived from the CI run or hostname).
RUNNER_ID=
# GITHUB_RUN_ID and GITHUB_ACTIONS are also read, but are set automatically by GitHub Actions.
